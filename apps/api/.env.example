PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/email_organizer
JWT_SECRET=change-me-long-random
IMAP_SECRET=0123456789abcdef0123456789abcdef
WEB_ORIGIN=http://localhost:3000
# Relative to apps/api when running the API, or absolute path.
# Default without this var: <repo>/apps/pi/auth.json
PI_AUTH_PATH=../pi/auth.json
CRON_INTERVAL_MS=300000

# true = organizza anche su IMAP (create cartelle, MOVE, delete), non solo Mongo
IMAP_WRITE_ENABLED=true

# --- SPID (Demo oggi; in produzione cambia metadata IdP + BASE_URL) ---
SPID_ENABLED=false
# URL pubblico dell'API visto dall'IdP (in locale: tunnel HTTPS)
SPID_BASE_URL=http://localhost:4000
# Opzionali (default da SPID_BASE_URL):
# SPID_ENTITY_ID=https://your-tunnel.example/auth/spid/metadata
# SPID_ACS_URL=https://your-tunnel.example/auth/spid/acs
# Demo IdP metadata: https://demo.spid.gov.it/metadata.xml → spid/idp-metadata.xml
SPID_IDP_METADATA_PATH=spid/idp-metadata.xml
SPID_SP_KEY_PATH=spid/sp-key.pem
SPID_SP_CERT_PATH=spid/sp-cert.pem
SPID_AUTHN_CONTEXT=https://www.spid.gov.it/SpidL1
# Metadata Organization / Contact (obbligatori per Demo Validator)
SPID_ORG_NAME=IMAP Organizer
SPID_ORG_DISPLAY_NAME=IMAP Organizer
# SPID_ORG_URL=  (default = SPID_BASE_URL)
SPID_CONTACT_EMAIL=spid@example.com
SPID_VAT_NUMBER=IT12345678901
# SPID_BILLING_ADDRESS=Via Roma 1
# SPID_BILLING_CAP=00100
# SPID_BILLING_CITY=Roma
# SPID_BILLING_PROVINCE=RM
# SPID_BILLING_COUNTRY=IT

COOKIE_NAME=io_session
