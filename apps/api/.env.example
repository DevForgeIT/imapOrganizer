PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/email_organizer
JWT_SECRET=change-me-long-random
IMAP_SECRET=0123456789abcdef0123456789abcdef
WEB_ORIGIN=http://localhost:3000
# Relative to apps/api when running the API, or absolute path.
# Default without this var: <repo>/apps/pi/auth.json
PI_AUTH_PATH=../pi/auth.json
CRON_INTERVAL_MS=300000

# true = organizza anche su IMAP (create cartelle, MOVE, delete), non solo Mongo
IMAP_WRITE_ENABLED=true
COOKIE_NAME=io_session
